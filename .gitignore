# Generated by Cargo
/target/

# These are also generated by Cargo, by `cargo update`
# In an application/CLI binary, Cargo.lock is kept under version control, but you can ignore scratch locks
# Cargo.lock

# Backup files generated by rustfmt
**/*.rs.bk

# Environment variables & secrets
*.env
*.env.local
*.env.*.local
.env

# OS specific files
.DS_Store
Thumbs.db

# IDE & Editor files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
